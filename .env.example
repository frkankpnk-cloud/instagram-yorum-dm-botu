# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur (KURULUM.md §5).
# .env GİZLİDİR: kimseyle paylaşma, GitHub'a yükleme (.gitignore zaten dışarıda tutar), ekran kaydına girmesin.
# Yapay zekâ asistanına (Claude Code, Codex, Cursor...) bu dosyayı okutma; değerleri sen yaz.
#
# Sıra: önce yalnız WEBHOOK_VERIFY_TOKEN + NGROK_URL ile bot "kurulum modunda" açılır ve Meta webhook
# doğrulamasını geçer; jeton ve secret'ı sonra eklersin. Bekçi altında bot .env değişince kendisi yeniden başlar.

# Webhook'u Meta'ya tanıtırken senin uydurduğun uzun, rastgele bir kelime.
# Meta panelindeki "Verify token" alanına birebir aynısını yazacaksın.
WEBHOOK_VERIFY_TOKEN=

# ngrok'un sana verdiği ücretsiz sabit adres, ör. https://ornek-isim.ngrok-free.app
# Boş bırakırsan ngrok hesabına atanmış adresi kendisi kullanır.
NGROK_URL=

# Meta uygulamasının secret'ı: App settings > Basic > "App secret" (Göster). Webhook imzası bununla doğrulanır.
META_APP_SECRET=
# İsteğe bağlı, yalnız eski "Instagram login" kurulumunda: Instagram app secret (bot ikisini de dener).
IG_APP_SECRET=

# Erişim jetonu. Unified login'de: panelin "Generate access tokens" adımındaki jeton ya da configuration'daki
# sistem kullanıcısı jetonu (Expiration: Never). Yalnız bir kez gösterilir; hemen buraya yapıştır.
IG_ACCESS_TOKEN=

# Instagram profesyonel hesabının kimliği (17 haneli, genelde 1784... ile başlar).
# Unified login'de DOLDUR: sistem kullanıcısı jetonunda hesap listesi boş dönebiliyor. Nereden bulunur: KURULUM.md §4.
# Eski Instagram login'de boş kalabilir.
IG_USER_ID=

# unified (yeni uygulamalar; graph.facebook.com) ya da instagram (eski Instagram login; graph.instagram.com, 60 günlük jeton)
API_TURU=unified

# true: eşleşmeleri yalnız loga yazar, hiçbir DM/yorum GÖNDERMEZ. Testleri bitirince false yap.
DRY_RUN=true

# Botun yerel portu (ngrok buraya yönlendirir).
PORT=8787

# ngrok PATH'te değilse tam yolu, ör. C:\ngrok\ngrok.exe ya da /opt/homebrew/bin/ngrok
NGROK_YOLU=
# true: bekçi ngrok'u açmaz (ngrok'u ayrı bir hizmet olarak çalıştırıyorsan).
NGROK_KAPALI=false

# true: gelen ham webhook gövdesi loga yazılır (ilk kurulumda biçimi görmek için; çalıştığını görünce false yap).
LOG_HAM=false

# Gelişmiş (genelde dokunma). GRAPH_API_HOST boşsa API_TURU'na göre seçilir.
GRAPH_API_VERSION=v26.0
GRAPH_API_HOST=
